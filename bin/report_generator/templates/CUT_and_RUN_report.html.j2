<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CUT_and_RUN_report</title>
    <link href="static/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="static/css/dataTables.bootstrap5.min.css">
    <style>
      body { padding-top: 3.5rem; }
      .nav-sidebar { position: fixed; top: 56px; left: 0; width: 220px; height: 100%; padding: 1rem; overflow-y: auto; }
      .content { margin-left: 240px; padding: 1rem; }
      .section { margin-bottom: 2rem; }
      .navbar { background: linear-gradient(135deg, #6f42c1 0%, #8b5cf6 100%); }
      .nav-link { color: #555 !important; }
      .nav-link:hover { color: #6f42c1 !important; font-weight: 600; }
      .section h3 { color: #6f42c1; border-bottom: 3px solid #8b5cf6; padding-bottom: 0.5rem; }
      .card-header { background-color: #f3f0ff; border-bottom: 2px solid #8b5cf6; }
      a { color: #6f42c1; }
      a:hover { color: #8b5cf6; }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">CUT&RUN Report</a>
      </div>
    </nav>

    <div class="nav-sidebar bg-light">
      <h6>Sections</h6>
      <ul class="nav flex-column">
        <li class="nav-item"><a class="nav-link" href="#qc">QC</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#qc-frip">FRiP Scores</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#qc-peak-feature">Peak Feature GC</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#qc-coverage">ChIP Coverage</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#qc-per-replicate">Per-Replicate QC</a></li>
        <li class="nav-item"><a class="nav-link" href="#promoter_gc">Promoter GC / Differential Binding</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#promoter_gain">Promoter Gain</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#promoter_loss">Promoter Loss</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#diffbind_top1000">Top 1000 PNGs</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#diffbind_data">Top 1000 Data</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#diffbind_pval">Raw p-value Analysis</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#diffbind_plots">Volcano / MA</a></li>
        <li class="nav-item"><a class="nav-link" href="#deseq2">DESeq2 Differential Analysis</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#deseq2_results">Results & Plots</a></li>
        <li class="nav-item"><a class="nav-link" href="#peaks">Peak Visualizations</a></li>
        <li class="nav-item"><a class="nav-link" href="#annotations">Motifs & Annotations</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#homer_reports">HOMER Reports</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#homer_tables">HOMER Tables</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#chipseeker_preview">ChIPseeker Preview</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#chipseeker_comparison_plots">ChIPseeker Comparison PNGs</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#chipseeker_per_replicate">ChIPseeker Per-Replicate</a></li>
        <li class="nav-item"><a class="nav-link ms-3" href="#chipseeker_alternative">ChIPseeker Alternatives</a></li>
      </ul>
    </div>

    <main class="content">
      <div class="container-fluid">
        <div id="qc" class="section">
          <h3>QC</h3>
          <p><strong>Question:</strong> Are sample-level QC metrics within expected ranges? (FRiP, fragment length, mapping quality)</p>
          {% if ctx.previews.frip %}
          <h5 id="qc-frip">FRiP Scores</h5>
          <div class=\"table-responsive\">{{ ctx.previews.frip|safe }}</div>
          {% else %}
          <p>No FRiP metrics found in staging directory.</p>
          {% endif %}

          <h5 id="qc-peak-feature">Peak Feature GC Content Analysis</h5>
          {% if ctx.gc_plots_rel %}
            <div class="row">
              {% for label, rel_path in ctx.gc_plots_rel.items() %}
                <div class="col-md-6 mb-4">
                  {% if rel_path %}
                    <div class="card">
                      <div class="card-body p-2">
                        <img src="{{ rel_path }}" alt="{{ label }}" class="img-fluid">
                        <div class="small text-muted mt-2"><strong>{{ label|replace('_', ' ')|title }}</strong></div>
                      </div>
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
            <p class="small text-muted mt-2"><em>Shows GC% distribution of peaks across replicates and conditions. Consistency indicates good peak quality.</em></p>
          {% else %}
            <p class="text-muted">No GC content analysis plots found.</p>
          {% endif %}

          <h5 id="qc-coverage">ChIP Coverage Comparison</h5>
          {% if ctx.coverage_plots_rel %}
            <div class="row">
              {% for label, rel_path in ctx.coverage_plots_rel.items() %}
                <div class="col-md-6 mb-4">
                  {% if rel_path %}
                    <div class="card">
                      <div class="card-body p-2">
                        <img src="{{ rel_path }}" alt="{{ label }}" class="img-fluid">
                        <div class="small text-muted mt-2"><strong>{{ label }}</strong></div>
                      </div>
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
            <p class="small text-muted mt-2"><em>Normalized read coverage at peaks. Helps identify samples with poor ChIP efficiency or outlier normalization.</em></p>
          {% else %}
            <p class="text-muted">No coverage comparison plots found.</p>
          {% endif %}

          <h5 id="qc-per-replicate">Per-Replicate Quality Control</h5>
          {% if ctx.per_replicate_chipseeker_rel %}
            <p class="small"><em>Expand each condition to inspect individual replicate peak annotations and coverage.</em></p>
            {% for condition, replicates in ctx.per_replicate_chipseeker_rel.items() %}
              <div class="card mb-3">
                <div class="card-header" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#collapse-{{ condition|replace(' ', '_')|replace('/', '_') }}">
                  <strong>{{ condition }}</strong> <span class="float-end">▼</span>
                </div>
                <div id="collapse-{{ condition|replace(' ', '_')|replace('/', '_') }}" class="collapse">
                  <div class="card-body">
                    {% for replicate, plots in replicates.items() %}
                      <div class="mb-4">
                        <h6 class="text-muted">{{ replicate }}</h6>
                        <div class="row">
                          {% for plot_type, rel_path in plots.items() %}
                            <div class="col-md-4 mb-3">
                              {% if rel_path %}
                                <img src="{{ rel_path }}" alt="{{ replicate }} {{ plot_type }}" class="img-fluid" style="border: 1px solid #ddd; padding: 3px;">
                                <div class="small text-muted mt-1">{{ plot_type|replace('_', ' ')|title }}</div>
                              {% endif %}
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <p class="text-muted">No per-replicate ChIPseeker plots found.</p>
          {% endif %}
        </div>

        <div id="promoter_gc" class="section">
          <h3>Promoter GC / Differential Binding</h3>
          <p><strong>Question:</strong> Which promoter regions show gain or loss of binding between groups?</p>

          <h5 id="promoter_gain">Promoter Gain (preview)</h5>
          {% if ctx.previews.promoter_gain %}
          <div class="table-responsive">{{ ctx.previews.promoter_gain|safe }}</div>
          <p><a href="{{ ctx.promoter_gain_rel[0] if ctx.promoter_gain_rel else '#' }}">Download full promoter_gain.tsv</a></p>
          {% else %}
          <p>No promoter_gain.tsv found.</p>
          {% endif %}

          <h5 id="promoter_loss">Promoter Loss (preview)</h5>
          {% if ctx.previews.promoter_loss %}
          <div class="table-responsive">{{ ctx.previews.promoter_loss|safe }}</div>
          <p><a href="{{ ctx.promoter_loss_rel[0] if ctx.promoter_loss_rel else '#' }}">Download full promoter_loss.tsv</a></p>
          {% else %}
          <p>No promoter_loss.tsv found.</p>
          {% endif %}

          <h5 id="diffbind_top1000">Top 1000 differential-binding PNGs</h5>
          {% if ctx.diffbind_plots_rel %}
            {% for contrast, plots in ctx.diffbind_plots_rel.items() %}
              <div class="card mb-3">
                <div class="card-header"><strong>{{ contrast }}</strong></div>
                <div class="card-body">
                  <div class="row">
                    {% for plot in plots %}
                      <div class="col-md-6" style="margin-bottom: 1rem;">
                        <img src="{{ plot }}" alt="{{ plot|basename }}" class="img-fluid">
                        <div class="small text-muted mt-1">{{ plot|basename }}</div>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
            {% endfor %}
          {% else %}
            <p>No top-1000 differential-binding PNGs found.</p>
          {% endif %}

          <h5 id="diffbind_data">Top 1000 data files and GC statistics</h5>
          {% if ctx.diffbind_data_rel %}
            {% for contrast, data in ctx.diffbind_data_rel.items() %}
              <div class="card mb-3">
                <div class="card-header"><strong>{{ contrast }}</strong></div>
                <div class="card-body">
                  <h6>Download data files:</h6>
                  <ul>
                    {% if data.gain %}
                      <li><a href="{{ data.gain }}" download>{{ data.gain|basename }}</a> (Top 1000 Gain)</li>
                    {% endif %}
                    {% if data.loss %}
                      <li><a href="{{ data.loss }}" download>{{ data.loss|basename }}</a> (Top 1000 Loss)</li>
                    {% endif %}
                    {% if data.gc_test %}
                      <li><a href="{{ data.gc_test }}" download>{{ data.gc_test|basename }}</a> (GC Test Stats)</li>
                    {% endif %}
                  </ul>
                  
                  {% if data.gc_test_html %}
                    <h6 class="mt-3">GC Content Statistics:</h6>
                    <div class="table-responsive">
                      {{ data.gc_test_html|safe }}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            <p>No top-1000 data files found.</p>
          {% endif %}

          <div style="border-top: 3px solid #6f42c1; padding-top: 2rem; margin-top: 2rem;">
            <h5 id="diffbind_pval" style="color: #6f42c1;">Raw p-value Analysis (p ≤ 0.05)</h5>
            <p><em><strong>Note:</strong> This section shows results using raw p-values (p ≤ 0.05) instead of FDR-adjusted p-values for comparison. Use with caution for small sample numbers.</em></p>
            
            {% if ctx.diffbind_plots_pval_rel or ctx.diffbind_data_pval_rel %}
              <h6>GC Content Plots</h6>
              {% if ctx.diffbind_plots_pval_rel %}
                {% for contrast, plots in ctx.diffbind_plots_pval_rel.items() %}
                  <div class="card mb-3">
                    <div class="card-header"><strong>{{ contrast }}</strong></div>
                    <div class="card-body">
                      <div class="row">
                        {% for plot in plots %}
                          <div class="col-md-6" style="margin-bottom: 1rem;">
                            <img src="{{ plot }}" alt="{{ plot|basename }}" class="img-fluid">
                            <div class="small text-muted mt-1">{{ plot|basename }}</div>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                {% endfor %}
              {% else %}
                <p>No raw p-value GC plots found.</p>
              {% endif %}

              <h6>GC Content Statistics (Raw p-value)</h6>
              {% if ctx.diffbind_data_pval_rel %}
                {% for contrast, data in ctx.diffbind_data_pval_rel.items() %}
                  <div class="card mb-3">
                    <div class="card-header"><strong>{{ contrast }}</strong></div>
                    <div class="card-body">
                      {% if data.gc_test %}
                        <p><a href="{{ data.gc_test }}" download>{{ data.gc_test|basename }}</a></p>
                      {% endif %}
                      
                      {% if data.gc_test_html %}
                        <div class="table-responsive">
                          {{ data.gc_test_html|safe }}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}
              {% else %}
                <p>No raw p-value GC statistics found.</p>
              {% endif %}
            {% else %}
              <p><em>No raw p-value results available. This is normal if the workflow did not run with promoter GC analysis enabled.</em></p>
            {% endif %}
          </div>

          <h5 id="diffbind_plots">Volcano / MA plots</h5>
          <div class="row">
            <div class="col-md-6">
              {% if ctx.volcano_rel %}
                <img src="{{ ctx.volcano_rel[0] }}" alt="volcano" class="img-fluid">
              {% else %}
                <p>No volcano plot found.</p>
              {% endif %}
            </div>
            <div class="col-md-6">
              {% if ctx.ma_rel %}
                <img src="{{ ctx.ma_rel[0] }}" alt="MA plot" class="img-fluid">
              {% else %}
                <p>No MA plot found.</p>
              {% endif %}
            </div>
          </div>
        </div>

        <div id="deseq2" class="section">
          <h3>DESeq2 Differential Peak Analysis</h3>
          <p><strong>Question:</strong> Which peaks show significant differential binding between treatment and control groups?</p>
          
          {% if ctx.deseq2_significant_rel or ctx.deseq2_results_rel %}
            <h5 id="deseq2_results">Results & Plots</h5>
            
            {% if ctx.deseq2_significant_rel %}
              <div class="card mb-3">
                <div class="card-header"><strong>Significant Peaks (FDR ≤ 0.05)</strong></div>
                <div class="card-body">
                  <p><a href="{{ ctx.deseq2_significant_rel }}" class="btn btn-sm btn-outline-primary" download><strong>📊 Download Significant Results CSV</strong></a></p>
                  {% if ctx.previews.deseq2_significant %}
                    <div class="table-responsive mt-3" style="max-height: 500px; overflow-y: auto;">
                      {{ ctx.previews.deseq2_significant|safe }}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
            
            {% if ctx.deseq2_results_rel %}
              <div class="card mb-3">
                <div class="card-header"><strong>All Peak Results</strong></div>
                <div class="card-body">
                  <p><a href="{{ ctx.deseq2_results_rel }}" class="btn btn-sm btn-outline-primary" download><strong>📊 Download All Results CSV</strong></a></p>
                </div>
              </div>
            {% endif %}
            
            <div class="row mt-4">
              {% if ctx.deseq2_volcano_rel %}
                <div class="col-md-6 mb-3">
                  <div class="card">
                    <div class="card-header"><strong>Volcano Plot</strong></div>
                    <div class="card-body">
                      <p><small class="text-muted">PNG (fast loading)</small></p>
                      <img src="{{ ctx.deseq2_volcano_rel }}" alt="Volcano Plot" class="img-fluid" style="max-width: 100%;">
                    </div>
                  </div>
                </div>
              {% endif %}
              {% if ctx.deseq2_ma_rel %}
                <div class="col-md-6 mb-3">
                  <div class="card">
                    <div class="card-header"><strong>MA Plot</strong></div>
                    <div class="card-body">
                      <p><small class="text-muted">PNG (fast loading)</small></p>
                      <img src="{{ ctx.deseq2_ma_rel }}" alt="MA Plot" class="img-fluid" style="max-width: 100%;">
                    </div>
                  </div>
                </div>
              {% endif %}
            </div>
          {% else %}
            <p><em>No DESeq2 results found in staging directory.</em></p>
          {% endif %}
        </div>

        <div id="peaks" class="section">
          <h3>Peak Visualizations</h3>        <div id="peaks" class="section">
          <h3>Peak Visualizations</h3>
          <p><strong>Question:</strong> What do the top peaks look like across samples? (pyGenomeTracks snapshots)</p>
          {% if ctx.pygenometracks_rel %}
            {% for condition, features in ctx.pygenometracks_rel.items() %}
              <div class="card mb-3">
                <div class="card-header"><strong>{{ condition }}</strong></div>
                <div class="card-body">
                  {% for feature, images in features.items() %}
                    <h6>{{ feature }}</h6>
                    <div class="row">
                      {% for item in images %}
                        <div class="col-md-6" style="margin-bottom: 1rem;">
                          <img src="{{ item.png }}" alt="{{ item.png|basename }}" class="img-fluid">
                          {% if item.pdf %}
                            <div class="mt-2">
                              <a href="{{ item.pdf }}" target="_blank" rel="noopener">Open PDF</a>
                            </div>
                          {% endif %}
                        </div>
                      {% endfor %}
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            <p>No peak visualizations found.</p>
          {% endif %}
        </div>

        <div id="annotations" class="section">
          <h3>Motifs & Annotations</h3>
          <p><strong>Question:</strong> What motifs and genomic annotations are enriched in peaks?</p>
          {% if ctx.homer_reports %}
            <h5 id="homer_reports">HOMER Motif Reports</h5>
            <ul>
              {% for report in ctx.homer_reports %}
                <li><a href="{{ report.link }}">{{ report.label }} HOMER report</a></li>
              {% endfor %}
            </ul>
          {% endif %}
          {% if ctx.homer_tables_rel %}
            <h5 id="homer_tables">HOMER motif tables</h5>
            <ul>
              {% for table in ctx.homer_tables_rel %}
                <li><a href="{{ table.link }}">{{ table.label }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
          {% if not ctx.homer_reports and not ctx.homer_tables_rel %}
            <p>No HOMER results found.</p>
          {% endif %}

          {% if ctx.previews.chipseeker %}
            <h5 id="chipseeker_preview">ChIPseeker annotation (preview)</h5>
            <div class="table-responsive">{{ ctx.previews.chipseeker|safe }}</div>
            <p><a href="{{ ctx.chipseeker_rel[0] if ctx.chipseeker_rel else '#' }}">Download full ChIPseeker annotation TSV</a></p>
            {% if ctx.chipseeker_comparison_plots_rel %}
              <h6 id="chipseeker_comparison_plots">ChIPseeker comparison plots</h6>
              <div class="row">
                {% for plot in ctx.chipseeker_comparison_plots_rel %}
                  <div class="col-md-6" style="margin-bottom: 1rem;">
                    <img src="{{ plot }}" alt="{{ plot|basename }}" class="img-fluid">
                    <div class="small text-muted mt-1">{{ plot|basename }}</div>
                  </div>
                {% endfor %}
              </div>
            {% endif %}

            {% if ctx.per_replicate_chipseeker_rel %}
              <h6 id="chipseeker_per_replicate">Per-Replicate ChIPseeker Plots</h6>
              <p class="small text-muted"><em>Detailed view of each replicate's peak annotations and quality metrics. Use to identify problematic replicates.</em></p>
              {% for condition, replicates in ctx.per_replicate_chipseeker_rel.items() %}
                <div class="card mb-3">
                  <div class="card-header" style="cursor: pointer;" data-bs-toggle="collapse" data-bs-target="#chipseeker-{{ condition|replace(' ', '_')|replace('/', '_') }}">
                    <strong>{{ condition }}</strong> <span class="float-end">▼</span>
                  </div>
                  <div id="chipseeker-{{ condition|replace(' ', '_')|replace('/', '_') }}" class="collapse">
                    <div class="card-body">
                      {% for replicate in replicates.keys()|sort %}
                        <div class="mb-4 pb-3 border-bottom">
                          <h6 class="text-secondary">{{ replicate }}</h6>
                          <div class="row">
                            {% for plot_type, rel_path in replicates[replicate].items()|sort %}
                              <div class="col-md-3 mb-3">
                                {% if rel_path %}
                                  <img src="{{ rel_path }}" alt="{{ replicate }} {{ plot_type }}" class="img-fluid" style="border: 1px solid #eee; padding: 2px;">
                                  <div class="small text-muted mt-1">{{ plot_type|replace('_', ' ')|title }}</div>
                                {% endif %}
                              </div>
                            {% endfor %}
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            {% endif %}

            {% if ctx.alternative_chipseeker_plots_rel %}
              <h6 id="chipseeker_alternative">Alternative ChIPseeker Comparison Plots</h6>
              <p class="small text-muted"><em>Additional perspectives on peak annotations: slim versions, condition-grouped views, and condition-specific distributions.</em></p>
              <div class="row">
                {% for label, rel_path in ctx.alternative_chipseeker_plots_rel.items() %}
                  {% if rel_path %}
                    <div class="col-md-6 mb-4">
                      <div class="card">
                        <div class="card-body p-2">
                          <img src="{{ rel_path }}" alt="{{ label }}" class="img-fluid">
                          <div class="small text-muted mt-2">{{ label }}</div>
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          {% else %}
            <p>No ChIPseeker annotation found.</p>
          {% endif %}
        </div>

      </div>
    </main>

    <script src="static/js/jquery.min.js"></script>
    <script src="static/js/bootstrap.bundle.min.js"></script>
    <script src="static/js/jquery.dataTables.min.js"></script>
    <script src="static/js/dataTables.bootstrap5.min.js"></script>
  </body>
</html>