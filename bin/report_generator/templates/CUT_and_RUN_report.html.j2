<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CUT_and_RUN_report</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
    <style>
      body { padding-top: 3.5rem; }
      .nav-sidebar { position: fixed; top: 56px; left: 0; width: 220px; height: 100%; padding: 1rem; overflow-y: auto; }
      .content { margin-left: 240px; padding: 1rem; }
      .section { margin-bottom: 2rem; }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
      <div class="container-fluid">
        <a class="navbar-brand" href="#">CUT&RUN Report</a>
      </div>
    </nav>

    <div class="nav-sidebar bg-light">
      <h6>Sections</h6>
      <ul class="nav flex-column">
        <li class="nav-item"><a class="nav-link" href="#qc">QC</a></li>
        <li class="nav-item"><a class="nav-link" href="#promoter_gc">Promoter GC / Differential Binding</a></li>
        <li class="nav-item"><a class="nav-link" href="#annotations">Motifs & Annotations</a></li>
      </ul>
    </div>

    <main class="content">
      <div class="container-fluid">
        <div id="qc" class="section">
          <h3>QC</h3>
          <p><strong>Question:</strong> Are sample-level QC metrics within expected ranges? (FRiP, fragment length, mapping quality)</p>
          {% if ctx.frip %}
          <h5>FRiP / QC tables</h5>
          <ul>
            {% for f in ctx.frip %}
              <li><a href="{{ f|replace(ctx.staging_dir + '/', '') }}">{{ f|basename }}</a></li>
            {% endfor %}
          </ul>
          {% else %}
          <p>No FRiP metrics found in staging directory.</p>
          {% endif %}
        </div>

        <div id="promoter_gc" class="section">
          <h3>Promoter GC / Differential Binding</h3>
          <p><strong>Question:</strong> Which promoter regions show gain or loss of binding between groups?</p>

          <h5>Promoter Gain (preview)</h5>
          {% if ctx.previews.promoter_gain %}
          <div class="table-responsive">{{ ctx.previews.promoter_gain|safe }}</div>
          <p><a href="{{ ctx.promoter_gain[0]|replace(ctx.staging_dir + '/', '') }}">Download full promoter_gain.tsv</a></p>
          {% else %}
          <p>No promoter_gain.tsv found.</p>
          {% endif %}

          <h5>Promoter Loss (preview)</h5>
          {% if ctx.previews.promoter_loss %}
          <div class="table-responsive">{{ ctx.previews.promoter_loss|safe }}</div>
          <p><a href="{{ ctx.promoter_loss[0]|replace(ctx.staging_dir + '/', '') }}">Download full promoter_loss.tsv</a></p>
          {% else %}
          <p>No promoter_loss.tsv found.</p>
          {% endif %}

          <h5>Volcano / MA plots</h5>
          <div class="row">
            <div class="col-md-6">
              {% if ctx.volcano %}
                <img src="{{ ctx.volcano[0]|replace(ctx.staging_dir + '/', '') }}" alt="volcano" class="img-fluid">
              {% else %}
                <p>No volcano plot found.</p>
              {% endif %}
            </div>
            <div class="col-md-6">
              {% if ctx.ma %}
                <img src="{{ ctx.ma[0]|replace(ctx.staging_dir + '/', '') }}" alt="MA plot" class="img-fluid">
              {% else %}
                <p>No MA plot found.</p>
              {% endif %}
            </div>
          </div>
        </div>

        <div id="annotations" class="section">
          <h3>Motifs & Annotations</h3>
          <p><strong>Question:</strong> What motifs and genomic annotations are enriched in peaks?</p>
          {% if ctx.homer_html %}
            <p>HOMER results: <a href="{{ ctx.homer_html[0]|replace(ctx.staging_dir + '/', '') }}">{{ ctx.homer_html[0]|basename }}</a></p>
          {% else %}
            <p>No HOMER results found.</p>
          {% endif %}

          {% if ctx.previews.chipseeker %}
            <h5>ChIPseeker annotation (preview)</h5>
            <div class="table-responsive">{{ ctx.previews.chipseeker|safe }}</div>
            <p><a href="{{ ctx.chipseeker[0]|replace(ctx.staging_dir + '/', '') }}">Download full ChIPseeker annotation TSV</a></p>
          {% else %}
            <p>No ChIPseeker annotation found.</p>
          {% endif %}
        </div>

      </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
  </body>
</html>